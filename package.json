{
  "name": "tokensaver",
  "displayName": "TokenSaver",
  "description": "Compress AI shell output automatically — no TokViz install needed. Bundles TokViz, detects Cursor/Copilot/Gemini-Antigravity, installs hooks silently. Dashboard shows tokens saved. Unlike TokGuess (usage tracking), this actually reduces context sent to your agent.",
  "version": "0.5.3",
  "publisher": "maazizit",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#2ea043",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/maazizit/tokensaver"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Machine Learning",
    "Visualization"
  ],
  "keywords": [
    "tokens",
    "ai",
    "copilot",
    "cursor",
    "compression",
    "tokviz",
    "cost-optimization",
    "context",
    "antigravity",
    "gemini",
    "token-savings",
    "shell-compression"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tokensaver",
          "title": "TokenSaver",
          "icon": "media/tokensaver.svg"
        }
      ]
    },
    "views": {
      "tokensaver": [
        {
          "id": "tokensaver.dashboard",
          "name": "Savings Dashboard",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "tokensaver.showDashboard",
        "title": "TokenSaver: Show Dashboard",
        "icon": "$(graph)"
      },
      {
        "command": "tokensaver.refresh",
        "title": "TokenSaver: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "tokensaver.enableTracking",
        "title": "TokenSaver: Enable Token Tracking"
      },
      {
        "command": "tokensaver.resetMetrics",
        "title": "TokenSaver: Reset Metrics Baseline"
      },
      {
        "command": "tokensaver.enableProseMode",
        "title": "TokenSaver: Enable Prose Compression"
      },
      {
        "command": "tokensaver.auditMcp",
        "title": "TokenSaver: Audit MCP Servers"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "tokensaver.refresh",
          "when": "view == tokensaver.dashboard",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "TokenSaver",
      "properties": {
        "tokensaver.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show token savings in the status bar"
        },
        "tokensaver.proseMode": {
          "type": "string",
          "enum": ["off", "lite", "full", "ultra"],
          "default": "full",
          "description": "Install terse output rules/skills when hooks are set up"
        },
        "tokensaver.auditMcpOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Notify about MCP token overhead on startup when servers are detected"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "test": "npm run compile && node --test out/calculator.test.js out/commandBreakdown.test.js out/periodStats.test.js",
    "prepare-cli": "node scripts/prepare-cli.mjs",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run prepare-cli && npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.4.0"
  }
}
