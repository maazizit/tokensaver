{
  "name": "tokensaver",
  "displayName": "TokenSaver",
  "description": "Save AI tokens with smart compression. Powered by TokViz for shell output compression. Real-time dashboard shows your savings across Cursor, Copilot, and Gemini.",
  "version": "0.1.1",
  "publisher": "maazizit",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/maazizit/tokensaver"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Machine Learning",
    "Visualization"
  ],
  "keywords": [
    "tokens",
    "ai",
    "copilot",
    "cursor",
    "compression",
    "tokviz",
    "cost-optimization",
    "context"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tokensaver",
          "title": "TokenSaver",
          "icon": "media/tokensaver.svg"
        }
      ]
    },
    "views": {
      "tokensaver": [
        {
          "id": "tokensaver.dashboard",
          "name": "Savings Dashboard",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "tokensaver.showDashboard",
        "title": "TokenSaver: Show Dashboard",
        "icon": "$(graph)"
      },
      {
        "command": "tokensaver.installHooks",
        "title": "TokenSaver: Install TokViz Compression (Cursor)"
      },
      {
        "command": "tokensaver.installHooksCopilot",
        "title": "TokenSaver: Install TokViz Compression (Copilot)"
      },
      {
        "command": "tokensaver.doctor",
        "title": "TokenSaver: Check Installation"
      },
      {
        "command": "tokensaver.viewStats",
        "title": "TokenSaver: View Statistics",
        "icon": "$(graph-line)"
      },
      {
        "command": "tokensaver.compareAgents",
        "title": "TokenSaver: Compare Agents"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "tokensaver.showDashboard",
          "when": "view == tokensaver.dashboard",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "TokenSaver",
      "properties": {
        "tokensaver.tokvizPath": {
          "type": "string",
          "default": "tokviz",
          "description": "Path to TokViz CLI executable (default: tokviz in PATH)"
        },
        "tokensaver.autoInstallHooks": {
          "type": "boolean",
          "default": false,
          "description": "Automatically install TokViz compression hooks on first run"
        },
        "tokensaver.defaultAgent": {
          "type": "string",
          "enum": ["cursor", "copilot", "gemini"],
          "default": "cursor",
          "description": "Default AI agent for hook installation"
        },
        "tokensaver.enterpriseMode": {
          "type": "boolean",
          "default": false,
          "description": "Enterprise mode: metrics only, no command content logged"
        },
        "tokensaver.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show token savings in status bar"
        },
        "tokensaver.notifyOnSavings": {
          "type": "boolean",
          "default": true,
          "description": "Show notifications when significant token savings detected"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
